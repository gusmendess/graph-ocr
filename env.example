# auto = tesseract se o binário existir, senão rapidocr
GRAPH_OCR_OCR_ENGINE=auto
# GRAPH_OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Só para GRAPH_OCR_OCR_ENGINE=llm
# ANTHROPIC_API_KEY=
GRAPH_OCR_LLM_MODEL=claude-sonnet-5-5
# Imagem de referência usada por `make run <imagem>`
GRAPH_OCR_BASE_IMAGE=image.png
GRAPH_OCR_PHASH_THRESHOLD=0.7
# vector = cosseno entre vetores de texto (+ contexto do grafo); iou = texto exato + IoU
GRAPH_OCR_MATCHER=vector
GRAPH_OCR_COS_SAME=0.995
GRAPH_OCR_COS_EDIT=0.3
GRAPH_OCR_SLOT_OVERLAP=0.5
# 0 = só vetor de texto + cosseno; >0 mistura o contexto dos vizinhos no grafo
GRAPH_OCR_CONTEXT_WEIGHT=0.3
GRAPH_OCR_OCR_DIFFERENT_THRESHOLD=0.3
GRAPH_OCR_IOU_MATCH=0.5
GRAPH_OCR_IOU_SLOT=0.3
GRAPH_OCR_KNN_K=4

# Alinhamento de grafos (similarity | affine)
GRAPH_OCR_ALIGNMENT_MODEL=similarity
GRAPH_OCR_ALIGNMENT_ITERATIONS=2000
GRAPH_OCR_ALIGNMENT_INLIER_TOLERANCE=0.4
GRAPH_OCR_ALIGNMENT_MIN_INLIERS=4
GRAPH_OCR_ALIGNMENT_CANDIDATES_PER_NODE=5
# 0 = alinhamento puramente geométrico, ignora o texto
GRAPH_OCR_ALIGNMENT_TEXT_WEIGHT=0.5
GRAPH_OCR_ALIGNMENT_MAX_SCALE=4.0
GRAPH_OCR_ALIGNMENT_MIN_SEPARATION=3.0
GRAPH_OCR_ALIGNMENT_SEED=0

# Busca por vetor multimodal (visual + texto + layout); pesos iniciais, a calibrar com pares reais
GRAPH_OCR_WEIGHT_VISUAL=0.4
GRAPH_OCR_WEIGHT_TEXT=0.4
GRAPH_OCR_WEIGHT_LAYOUT=0.2
# DINOv2-small em ONNX (Apache-2.0), baixado na primeira vez; sem rede o bloco visual é desativado
GRAPH_OCR_VISUAL_ENABLED=true
GRAPH_OCR_VISUAL_SIZE=448
GRAPH_OCR_LAYOUT_GRID=16
GRAPH_OCR_INDEX_DIR=.cache/index
GRAPH_OCR_SEARCH_K=5
