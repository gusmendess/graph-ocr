# OCR: alimenta os blocos de texto e de layout do vetor
# auto = tesseract se o binário existir, senão rapidocr
GRAPH_OCR_OCR_ENGINE=auto
# GRAPH_OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Só para GRAPH_OCR_OCR_ENGINE=llm
# ANTHROPIC_API_KEY=
GRAPH_OCR_LLM_MODEL=claude-sonnet-5-5

# Cascata sha256 -> phash -> vetor. Abaixo deste limiar o phash decide sozinho; 0 = todos os pares vão ao vetor
GRAPH_OCR_PHASH_THRESHOLD=0.3

# Vetor multimodal (visual + texto + layout); pesos do score composto, a calibrar com pares reais
GRAPH_OCR_WEIGHT_VISUAL=0.01
GRAPH_OCR_WEIGHT_TEXT=0.90
GRAPH_OCR_WEIGHT_LAYOUT=0.09
# DINOv2-small em ONNX (Apache-2.0), baixado na primeira vez; sem rede o bloco visual é desativado
GRAPH_OCR_VISUAL_ENABLED=true
GRAPH_OCR_VISUAL_SIZE=448
GRAPH_OCR_LAYOUT_GRID=16
GRAPH_OCR_INDEX_DIR=.cache/index
# pastas indexadas por padrão (make index / make index-images)
GRAPH_OCR_INDEX_SOURCE=data/samples/documents
GRAPH_OCR_IMAGES_SOURCE=data/samples/dresses
GRAPH_OCR_SEARCH_K=10

# Busca de imagens por linguagem natural (SigLIP2 em ONNX, sem quantização; baixa na primeira vez)
# base = 1,5 GB, 0,13 s/imagem | so400m = 4,5 GB, 2,5 s/imagem (mais robusto). Ao trocar, apague o índice e reindexe.
GRAPH_OCR_SIGLIP_MODEL=base
# pad = preserva a proporção da foto | squash = estica para um quadrado
GRAPH_OCR_SIGLIP_RESIZE=pad
GRAPH_OCR_SIGLIP_MODELS_DIR=.cache/models
GRAPH_OCR_SEMANTIC_INDEX_DIR=.cache/semantic_index
